NODE_ENV=development
PORT=4000

# Must be a replica set (local rs0 or MongoDB Atlas) - transfers use multi-document transactions.
MONGO_URI=mongodb://localhost:27017/myfinance?replicaSet=rs0

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Stricter per-window limit for login/register/forgot/reset password.
AUTH_RATE_LIMIT_MAX=20

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12
# lax for local dev (same site). Use "none" in production when frontend and API are on different domains.
COOKIE_SAMESITE=lax
# Frontend URL, used to build password-reset links.
APP_URL=http://localhost:5173
