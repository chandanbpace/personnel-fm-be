NODE_ENV=development
PORT=4000

# Must be a replica set (local rs0 or MongoDB Atlas) - transfers use multi-document transactions.
MONGO_URI=mongodb://localhost:27017/myfinance?replicaSet=rs0

# Comma-separated browser origins allowed to call the API with cookies.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
